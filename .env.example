PORT=3000
SESSION_SECRET=campusshelf_dev_secret

# Database type: "json" (local files) or "mysql" (Docker MySQL)
DB_TYPE=mysql

# MySQL connection settings (for the app)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campusshelf
DB_USER=campusshelf
DB_PASSWORD=change_me

# Docker MySQL container environment variables
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=campusshelf
MYSQL_USER=campusshelf
MYSQL_PASSWORD=change_me

# Redis (optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
