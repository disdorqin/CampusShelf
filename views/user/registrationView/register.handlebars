<div class="form-wrap" style="max-width:480px">
  <h2 style="text-align:center">🎉 创建账号</h2>
  {{#if error}}<div class="alert alert-error">{{error}}</div>{{/if}}
  <form method="post" action="/register">
    <div class="row2">
      <div class="field">
        <label>名</label>
        <input name="firstNameInput" placeholder="名" required>
      </div>
      <div class="field">
        <label>姓</label>
        <input name="lastNameInput" placeholder="姓">
      </div>
    </div>
    <div class="field">
      <label>邮箱</label>
      <input type="email" name="emailInput" placeholder="you@campus.edu" required>
    </div>
    <div class="field">
      <label>密码</label>
      <input type="password" name="passwordInput" placeholder="至少 6 位" required minlength="6">
    </div>
    <button class="btn btn-primary" type="submit" style="width:100%;justify-content:center">注册并登录</button>
  </form>
  <p style="text-align:center;margin-top:16px;color:var(--muted)">
    已有账号？<a href="/login" style="color:var(--primary);font-weight:700">去登录</a>
  </p>
</div>
