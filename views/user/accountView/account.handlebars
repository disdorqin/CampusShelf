<div class="form-wrap">
  <h2>⚙️ 账户设置</h2>
  {{#if error}}<div class="alert alert-error">{{error}}</div>{{/if}}
  <form method="post" action="/user/account">
    <div class="row2">
      <div class="field"><label>名</label><input name="firstNameInput" value="{{user.firstName}}"></div>
      <div class="field"><label>姓</label><input name="lastNameInput" value="{{user.lastName}}"></div>
    </div>
    <div class="field"><label>邮箱</label><input name="emailInput" value="{{user.email}}"></div>
    <div class="field"><label>新密码（留空则不修改）</label><input type="password" name="passwordInput" placeholder="••••••"></div>
    <button class="btn btn-primary" type="submit" style="width:100%;justify-content:center">保存修改</button>
  </form>
  <p style="margin-top:14px"><a href="/user" style="color:var(--primary)">← 返回个人中心</a></p>
</div>
