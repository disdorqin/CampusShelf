<section class="section" style="margin-top:28px;max-width:820px">
  <div class="section-head"><h2>📦 购买记录</h2></div>
  {{#if purchases.length}}
    <div class="filters" style="box-shadow:none">
    {{#each purchases}}
      <div style="padding:10px 0;border-bottom:1px dashed var(--border)">
        {{#each this.book}}<div>📘 {{this.title}} · <span style="color:var(--danger)">¥{{this.price}}</span> · {{this.datePurchased}}</div>{{/each}}
      </div>
    {{/each}}
    </div>
  {{else}}
    <div class="alert alert-error">还没有购买记录。</div>
  {{/if}}
</section>
