<div class="page-header">
  <div>
    <div class="page-pretitle">{{{icon "dashboard"}}} 管理后台</div>
    <h1>{{{icon "users-plus"}}} 用户管理</h1>
  </div>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>{{{icon "user"}}} 姓名</th>
        <th>邮箱</th>
        <th style="text-align:center">{{{icon "settings"}}} 角色</th>
        <th style="text-align:center">{{{icon "database"}}} 已发布</th>
        <th style="text-align:center">{{{icon "shopping-cart"}}} 订单数</th>
        <th style="text-align:center">{{{icon "heart"}}} 收藏数</th>
      </tr>
    </thead>
    <tbody>
      {{#each users}}
      <tr>
        <td><strong>{{firstName}} {{lastName}}</strong></td>
        <td>{{email}}</td>
        <td style="text-align:center">{{#if isAdmin}}<span class="badge badge-primary">{{{icon "dashboard"}}} 管理员</span>{{else}}<span class="badge badge-gray">{{{icon "user"}}} 用户</span>{{/if}}</td>
        <td style="text-align:center"><strong>{{resourceCount}}</strong></td>
        <td style="text-align:center"><strong>{{orderCount}}</strong></td>
        <td style="text-align:center">{{favorites}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
