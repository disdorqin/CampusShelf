<div class="page-header">
  <div>
    <div class="page-pretitle">管理后台</div>
    <h1>👥 用户管理</h1>
  </div>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>姓名</th>
        <th>邮箱</th>
        <th style="text-align:center">角色</th>
        <th style="text-align:center">已发布</th>
        <th style="text-align:center">订单数</th>
        <th style="text-align:center">收藏数</th>
      </tr>
    </thead>
    <tbody>
      {{#each users}}
      <tr>
        <td><strong>{{firstName}} {{lastName}}</strong></td>
        <td>{{email}}</td>
        <td style="text-align:center">{{#if isAdmin}}<span class="badge badge-primary">管理员</span>{{else}}<span class="badge badge-gray">用户</span>{{/if}}</td>
        <td style="text-align:center"><strong>{{resourceCount}}</strong></td>
        <td style="text-align:center"><strong>{{orderCount}}</strong></td>
        <td style="text-align:center">{{favorites}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
