<div class="page-header">
  <div>
    <div class="page-pretitle">管理后台</div>
    <h1>💬 评论管理</h1>
  </div>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>用户</th>
        <th>资源</th>
        <th>评论内容</th>
        <th style="text-align:center">评分</th>
        <th>时间</th>
        <th style="text-align:center">操作</th>
      </tr>
    </thead>
    <tbody>
      {{#each comments}}
      <tr>
        <td><strong>{{userName}}</strong></td>
        <td><a href="/resources/{{resourceId}}">{{resourceTitle}}</a></td>
        <td style="max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text-secondary)">{{text}}</td>
        <td style="text-align:center;color:var(--warning);font-weight:600">{{stars rating}}</td>
        <td style="font-size:12px;color:var(--text-muted)">{{createdAt}}</td>
        <td style="text-align:center">
          <form method="post" action="/comments/{{id}}/delete" style="display:inline">
            <button class="btn-action btn-action-reject">🗑 删除</button>
          </form>
        </td>
      </tr>
      {{/each}}
      {{#unless comments.length}}<tr><td colspan="6" style="text-align:center;padding:40px;color:var(--text-muted)">暂无评论</td></tr>{{/unless}}
    </tbody>
  </table>
</div>
