<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{pageTitle}}</title>
  <meta name="description" content="CampusShelf 校园学习资源交易平台 - 二手教材、课程笔记、考研资料一站式资源共享">
  <link rel="icon" href="/images/logo.svg">
  <link rel="stylesheet" href="/public/css/campusshelf.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
</head>
<body>
  {{> header}}
  <div class="site-main">
    {{#if flash}}
      <div class="alert alert-{{flash.type}}">{{flash.msg}}</div>
    {{/if}}
    {{{body}}}
  </div>
  {{> footer}}
  <script src="/public/js/campusshelf.js"></script>
</body>
</html>
