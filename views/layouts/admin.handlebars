<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{pageTitle}}</title>
  <link rel="icon" href="/images/logo.svg">
  <link rel="stylesheet" href="/public/css/campusshelf.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
</head>
<body style="margin:0">
<div class="admin-body">
  <aside class="admin-sidebar">
    <div class="logo-area">
      <img src="/images/logo.svg" alt="">
      <div>CampusShelf<br><small style="font-weight:400;font-size:11px;color:#64748B">管理后台</small></div>
    </div>
    <nav class="admin-nav">
      <a href="/admin" class="{{#if (eq active 'dashboard')}}active{{/if}}"><span class="nav-icon">📊</span> Dashboard</a>
      <a href="/admin/resources" class="{{#if (eq active 'resources')}}active{{/if}}"><span class="nav-icon">📦</span> 资源管理</a>
      <a href="/admin/users" class="{{#if (eq active 'users')}}active{{/if}}"><span class="nav-icon">👥</span> 用户管理</a>
      <a href="/admin/orders" class="{{#if (eq active 'orders')}}active{{/if}}"><span class="nav-icon">📋</span> 订单管理</a>
      <a href="/admin/comments" class="{{#if (eq active 'comments')}}active{{/if}}"><span class="nav-icon">💬</span> 评论管理</a>
      <a href="/admin/stats" class="{{#if (eq active 'stats')}}active{{/if}}"><span class="nav-icon">📈</span> 数据统计</a>
    </nav>
    <div style="padding:12px 16px;border-top:1px solid #334155;font-size:12px;color:#64748B">
      <a href="/" style="color:#94A3B8">← 返回前台</a>
    </div>
  </aside>
  <main class="admin-main">
    {{#if flash}}
    <div class="alert alert-{{flash.type}}">{{flash.msg}}</div>
    {{/if}}
    {{{body}}}
  </main>
</div>
<script src="/public/js/admin.js"></script>
</body>
</html>
