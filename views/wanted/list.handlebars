<div class="container">
  <div class="page-header">
    <div>
      <div class="page-pretitle">{{{icon "home"}}} CampusShelf</div>
      <h1>{{{icon "messages"}}} 校园求购墙</h1>
    </div>
    <div class="page-actions">
      <a href="/resources/publish" class="btn btn-primary">{{{icon "plus"}}} 发布资源</a>
    </div>
  </div>

  <p style="color:var(--text-secondary);margin-bottom:24px;font-size:14px">
    同学们正在求购这些资料和用品，如有闲置可以联系他们！
  </p>

  {{#if posts.length}}
  <div class="wanted-grid">
    {{#each posts}}
    <div class="wanted-card">
      <div class="title">{{{icon "clipboard-text"}}} {{title}}</div>
      <div class="meta">
        <span class="badge badge-gray">{{{icon "map-pin"}}} {{campus}}</span>
        <span class="badge badge-gray">{{{icon "book-2"}}} {{courseName}}</span>
        <span>{{{icon "user"}}} {{posterName}}</span>
        <span>{{{icon "clock"}}} {{createdAt}}</span>
      </div>
      <div class="budget">{{{icon "coin"}}} 预算 ¥{{budget}}</div>
      <div class="desc">{{description}}</div>
      {{#if contact}}
      <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);font-size:13px;color:var(--text-secondary)">
        {{{icon "messages"}}} 联系：{{contact}}
      </div>
      {{/if}}
    </div>
    {{/each}}
  </div>
  {{else}}
  <div class="empty-state">
    <div class="icon">{{{icon "messages"}}}</div>
    <h3>暂无求购信息</h3>
    <p>稍后再来看看吧</p>
  </div>
  {{/if}}
</div>
